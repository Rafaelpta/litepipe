{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "litepipe beta",
  "identifier": "dev.litepipe.beta",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "publisher": "litepipe",
    "category": "DeveloperTool",
    "shortDescription": "Lean, local screen and audio recording",
    "longDescription": "litepipe records your screen and audio locally and makes it searchable. A lean, fast fork of Screenpipe focused on low CPU and disk use. Fully local, you own your data.",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/256x256.png",
      "icons/beta/512x512.png",
      "icons/beta/1024x1024.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-beta.png"
    ],
    "resources": [
      "assets/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "screenpipe-beta"
        ]
      },
      "mobile": [
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/auth"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/stripe-connect"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/purchase-successful"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/settings"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/changelog"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/onboarding"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/status"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.screenpipe/**"
        ]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
